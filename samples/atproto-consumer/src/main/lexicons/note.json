{
  "lexicon": 1,
  "id": "com.example.sample.note",
  "defs": {
    "main": {
      "type": "record",
      "description": "A short note. The sample's Gradle build generates its Kotlin model from this schema.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
