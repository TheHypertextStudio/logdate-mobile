# Non-secret configuration for the LogDate Cloud server on one machine.
# ./generate-secrets.sh copies this to logdate.env the first time it runs; edit logdate.env, not
# this file. The values mirror infra/terraform/production.tfvars, minus Google Cloud.

LOGDATE_ENV=production

# How the internet reaches this machine: caddy (HTTPS on ports 80 and 443, DNS points here) or
# tunnel (a Cloudflare Tunnel, no open ports; needs tunnel.env). See README.md.
LOGDATE_EDGE=caddy
HOST=0.0.0.0
PORT=8080

# LogDate Cloud's identity. The apps look for this origin, so keep it unless the domain moves.
LOGDATE_DEPLOYMENT_KIND=first_party
LOGDATE_SERVER_DISPLAY_NAME=LogDate Cloud
LOGDATE_PUBLIC_ORIGIN=https://cloud.logdate.app
ATPROTO_PDS_SERVICE_URL=https://cloud.logdate.app
ATPROTO_HANDLE_DOMAIN=logdate.app

# Unset on purpose. It demands Google Cloud Storage and a billing provider, which this machine
# does not have; every other production check still runs.
# LOGDATE_EXPECT_FIRST_PARTY=true

# Without a billing provider every account is unlimited and nothing is for sale. The apps keep
# plans hidden (the cloud_plans flag is off), so the beta sees no difference.
BILLING_PROVIDER=disabled

# Passkeys. The relying party is logdate.app, whose site serves assetlinks.json and
# apple-app-site-association; that site is not on this machine and does not change.
WEBAUTHN_RP_ID=logdate.app
WEBAUTHN_ORIGIN=https://cloud.logdate.app
# The browser origin, then the upload key's and Play App Signing's APK origins, from
# android_signing_certificates in infra/terraform/production.tfvars.
WEBAUTHN_ALLOWED_ORIGINS=https://cloud.logdate.app,android:apk-key-hash:_EKa7B6AOqolPCa4GiX8QRcSu1XnCdVat2EvXfKCx90,android:apk-key-hash:7epoIxi73keDS4F98iOOS6UMFG0PSqYI1v3v-N5sibI
ANDROID_CERT_FINGERPRINTS=FC:42:9A:EC:1E:80:3A:AA:25:3C:26:B8:1A:25:FC:41:17:12:BB:55:E7:09:D5:5A:B7:61:2F:5D:F2:82:C7:DD,ED:EA:68:23:18:BB:DE:47:83:4B:81:7D:F2:23:8E:4B:A5:0C:14:6D:0F:4A:A6:08:D6:FD:EF:F8:DE:6C:89:B2

SERVER_ENCRYPTION_ENABLED=true
SYNC_MEDIA_SIGNED_URLS=true
SYNC_MEDIA_SIGNED_URL_TTL_HOURS=1

# The last X-Forwarded-For entry is the client with either edge: Caddy replaces what a client
# sends with the client's address, and Cloudflare appends the client's address before the tunnel
# hands the request over unchanged.
TRUSTED_PROXY_HOPS=0

# One server process owns the database, so it applies migrations itself when it starts.
AUTO_MIGRATE=true

ATPROTO_RECOVERY_KEYS_ENABLED=true
LOGDATE_PERSONAL_SPACE_ENABLED=true
LOGDATE_PERSONAL_SPACE_MIGRATION_ENABLED=true
