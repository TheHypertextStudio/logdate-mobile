#!/usr/bin/env bash
# pre-push hook - Final quality gate before code leaves the machine
#
# Checks:
# 1. Commit message re-validation (catches --no-verify bypasses)
# 2. Full compile check
# 3. Tests for affected modules, and their iOS and Wasm test compilation
# 4. Dead code: detekt on affected modules and SearchDeadCode across the repository

set -euo pipefail

# Keep every product push subprocess headless, including task discovery.
# Retain caller JVM options and override an earlier headless=false value.
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Djava.awt.headless=true"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
source "$REPO_ROOT/scripts/validation/hook-common.sh"

# Task discovery remains in the foreground as well.
fetch_module_tasks() {
  ./gradlew --no-daemon "${1}:tasks" --all --quiet 2> /dev/null || true
}

errors=()
local_shas=""

# Read stdin for push info (local_ref local_sha remote_ref remote_sha)
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip delete pushes
  if [[ "$local_sha" == "$ZERO_SHA" ]]; then
    continue
  fi

  local_shas="${local_shas}${local_sha}"$'\n'
done

if [[ -z "$local_shas" ]]; then
  exit 0
fi

commits="$(collect_unpushed_commits "$local_shas")"

if [[ -z "$commits" ]]; then
  exit 0
fi

# ============================================================================
# 1. Re-validate commit messages
# ============================================================================

# Canonical shared pre-push validates the complete transaction before this gate.

# ============================================================================
# 2. Full compile check
# ============================================================================

echo "Running compile check..."
if ! ./gradlew --no-daemon :app:android-main:assembleDebug --quiet 2>&1; then
  errors+=("COMPILE: Android app failed to compile. Fix build errors before pushing.")
fi

# ============================================================================
# 3. Screenshot coverage
# ============================================================================

echo "Checking OS integration screenshot coverage..."
if ! ./gradlew --no-daemon checkOsIntegrationScreenshotCoverage --quiet 2>&1; then
  errors+=("SCREENSHOTS: A registered screenshot is missing or a reference is stale. Run './run screenshots:check' for details.")
fi

# ============================================================================
# 4. Tests for affected modules
# ============================================================================

changed_files="$(collect_changed_files_from_commits "$commits")"
kt_files="$(echo "$changed_files" | grep -E '\.(kt|kts)$' || true)"

if [[ -n "$kt_files" ]]; then
  resolved_modules="$(modules_from_files "$kt_files")"
  modules=()
  while IFS= read -r module; do
    [[ -n "$module" ]] && modules+=("$module")
  done <<< "$resolved_modules"

  if [[ ${#modules[@]} -gt 0 ]]; then
    resolve_test_tasks_for_modules "balanced" "${modules[@]}"
    check_tasks=()

    if [[ ${#UNRESOLVED_TEST_MODULES[@]} -gt 0 ]]; then
      errors+=("TESTS: Unable to resolve test task for affected modules.")
      for mod in "${UNRESOLVED_TEST_MODULES[@]}"; do
        errors+=("  ${mod} (run './gradlew --no-daemon ${mod}:tasks --all' and add task mapping in hook-common.sh)")
      done
    elif [[ ${#RESOLVED_TEST_TASKS[@]} -gt 0 ]]; then
      echo "Running tests for affected modules: ${modules[*]}"
      echo "Resolved test tasks:"
      for mod in "${RESOLVED_TEST_TASKS[@]}"; do
        echo "  $mod"
      done
      check_tasks+=("${RESOLVED_TEST_TASKS[@]}")
    fi

    # The JVM tests pass code that Kotlin/Native and Kotlin/Wasm reject, such as a comma in a
    # backticked test name, so the affected modules' tests also compile for those targets.
    resolve_native_compile_tasks_for_modules "${modules[@]}"
    if [[ ${#RESOLVED_NATIVE_COMPILE_TASKS[@]} -gt 0 ]]; then
      echo "Compiling affected modules' tests for iOS and Wasm:"
      for task in "${RESOLVED_NATIVE_COMPILE_TASKS[@]}"; do
        echo "  $task"
      done
      check_tasks+=("${RESOLVED_NATIVE_COMPILE_TASKS[@]}")
    fi

    # One Gradle run for both, so a push starts Gradle once. --continue runs every check even when
    # one fails, and the failed task names in Gradle's report say which checks to report. The plain
    # console keeps that report free of terminal color codes whatever the user's Gradle settings.
    if [[ ${#check_tasks[@]} -gt 0 ]]; then
      check_output="$(mktemp "${TMPDIR:-/tmp}/logdate-pre-push.XXXXXX")"
      if ! ./gradlew --no-daemon --continue --console=plain "${check_tasks[@]}" --quiet 2>&1 | tee "$check_output"; then
        failed_kinds="$(gradle_failure_kinds < "$check_output")"
        if grep -qx tests <<< "$failed_kinds"; then
          errors+=("TESTS: Tests failed for affected modules. Fix test failures before pushing.")
        fi
        if grep -qx native <<< "$failed_kinds"; then
          errors+=("NATIVE: Affected modules' tests do not compile for iOS or Wasm, which reject some code the JVM accepts (such as a comma in a test name). Run './gradlew <module>:compileTestKotlinIosSimulatorArm64' for details.")
        fi
      fi
      rm "$check_output"
    fi

    # Unused private declarations, parameters and imports, plus the size rules, in the modules this
    # push changes. The compiler already fails on unused locals during the compile check above.
    detekt_tasks=()
    for mod in "${modules[@]}"; do
      detekt_tasks+=("${mod}:detekt")
    done
    echo "Checking affected modules for dead code: ${modules[*]}"
    if ! ./gradlew --no-daemon "${detekt_tasks[@]}" --quiet 2>&1; then
      errors+=("DEAD CODE: detekt found unused or oversized code in affected modules. Run './gradlew <module>:detekt' for details.")
    fi
  fi
fi

# Declarations no module, entry point or platform reaches, across the whole repository.
if [[ -n "$kt_files" ]]; then
  if command -v searchdeadcode > /dev/null 2>&1; then
    if ! searchdeadcode . --profile ci --unused-extras=false --write-only-dao=false --write-only-prefs=false > /dev/null 2>&1; then
      errors+=("DEAD CODE: SearchDeadCode found declarations nothing uses. Run './run lint:deadcode' for details.")
    fi
  else
    echo "Warning: SearchDeadCode is not installed, so cross-module dead code was not checked. Install it with 'hypertext setup --repo .'."
  fi
fi

if [[ ${#errors[@]} -gt 0 ]]; then
  print_error_report "PRE-PUSH VALIDATION FAILED" "Fix these issues before pushing."
  exit 1
fi

echo "Pre-push checks passed."
exit 0
