<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Remove target-app startup providers; the standalone test APK cannot load their classes. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>

    <!-- AndroidJUnitRunner reads its arguments from this meta-data as well as from the command line,
         so the startup wait applies to Gradle and am instrument runs alike. -->
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        tools:node="merge">
        <meta-data
            android:name="listener"
            android:value="app.logdate.client.e2e.LogDateStartupRunListener" />
    </instrumentation>
</manifest>
